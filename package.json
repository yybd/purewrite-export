{
    "name": "purewrite-export",
    "version": "0.3.0",
    "private": true,
    "description": "Book-ready Word and EPUB from a note or a folder, Hebrew and English alike — PureWrite's export engine in Obsidian.",
    "type": "module",
    "scripts": {
        "build": "node scripts/sync-engine.mjs --check && tsc --noEmit && eslint src && node esbuild.config.mjs production",
        "dev": "node esbuild.config.mjs",
        "sync-engine": "node scripts/sync-engine.mjs",
        "test": "vitest run",
        "lint": "eslint src"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/markdown-it": "14.1.2",
        "@types/node": "^22.0.0",
        "esbuild": "^0.25.0",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "happy-dom": "21.0.4",
        "obsidian": "^1.8.7",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.72.0",
        "vitest": "^3.2.7"
    },
    "dependencies": {
        "@tiptap/core": "3.32.0",
        "@tiptap/extension-image": "3.32.0",
        "@tiptap/extension-link": "3.32.0",
        "@tiptap/extension-list": "3.32.0",
        "@tiptap/extension-subscript": "3.32.0",
        "@tiptap/extension-superscript": "3.32.0",
        "@tiptap/extension-table": "3.32.0",
        "@tiptap/extension-text-align": "3.32.0",
        "@tiptap/extension-underline": "3.32.0",
        "@tiptap/pm": "3.32.0",
        "@tiptap/starter-kit": "3.32.0",
        "markdown-it": "14.3.3",
        "pagedjs": "0.4.3",
        "prosemirror-markdown": "1.13.4",
        "tiptap-markdown": "0.9.0"
    },
    "pnpm": {
        "overrides": {
            "markdown-it": "14.3.3"
        }
    },
    "packageManager": "pnpm@10.28.1"
}
